{
  "name": "brixeler-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:contracts": "node --experimental-strip-types --test tests/contracts.test.mjs",
    "test:growth": "node --experimental-strip-types --test tests/growth-contracts.test.mjs",
    "test:database": "./scripts/test-database-reliability.sh",
    "types:database": "./scripts/generate-database-types.sh check",
    "security:deps": "npm audit --audit-level=high",
    "security:shannon": "./scripts/security/run-shannon.sh",
    "security:all": "npm run security:deps && npm run lint && npm run test:contracts && npm run test:growth && npm run build",
    "release:check": "npm run security:all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.554.0",
    "next": "^16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "read-excel-file": "^9.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.21",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
